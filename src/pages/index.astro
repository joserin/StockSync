---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Instructions from '../components/Instructions.astro';
import ReconciliationManager from '../components/ReconciliationManager.tsx';
---

<Layout title="Reconciliador Pro - Inventory Intelligence">
	<Header />
    <main class="max-w-7xl mx-auto px-2 py-3">
		<ReconciliationManager client:load>
			<Instructions slot="instructions" />
		</ReconciliationManager>
	</main>
</Layout>
